diff --git a/applications/main/infrared/scenes/infrared_scene_find_remote.c b/applications/main/infrared/scenes/infrared_scene_find_remote.c
new file mode 100644
index 0000000..d97ac06
--- /dev/null
+++ b/applications/main/infrared/scenes/infrared_scene_find_remote.c
@@ -0,0 +1,195 @@
+#include "../infrared_app_i.h" // IWYU pragma: keep
+#include <strings.h> // strcasecmp
+
+// Find my TV / Projector: sends each brand's Power button (full brand remotes in
+// /ext/infrared/TVs or /Projectors, installed by WiFi > Update SD) one after another.
+// OK when the device reacts opens that brand's full remote.
+// Scene state: bit 0 = Projectors (else TVs), bit 4 = remote already opened.
+
+#define FIND_STATE_PROJECTORS 0x01u
+#define FIND_STATE_OPENED     0x10u
+#define FIND_EVT_NEXT         0x200u
+#define FIND_EVT_FOUND        0x201u
+#define FIND_EVT_START        0x202u
+#define FIND_MAX_BRANDS       96
+
+static struct {
+    FuriString* names[FIND_MAX_BRANDS];
+    size_t count, idx;
+    FuriTimer* timer;
+    const char* folder;
+    bool projectors;
+} find;
+
+static void find_tick(void* context) {
+    InfraredApp* infrared = context;
+    view_dispatcher_send_custom_event(infrared->view_dispatcher, FIND_EVT_NEXT);
+}
+
+static void find_result(DialogExResult result, void* context) {
+    InfraredApp* infrared = context;
+    if(result == DialogExResultCenter)
+        view_dispatcher_send_custom_event(infrared->view_dispatcher, FIND_EVT_FOUND);
+}
+
+static void find_start_result(DialogExResult result, void* context) {
+    InfraredApp* infrared = context;
+    if(result == DialogExResultCenter)
+        view_dispatcher_send_custom_event(infrared->view_dispatcher, FIND_EVT_START);
+}
+
+// Start prompt: nothing is sent until the user presses Start (like Find my AC).
+static void find_prompt(InfraredApp* infrared) {
+    DialogEx* d = infrared->dialog_ex;
+    dialog_ex_reset(d);
+    dialog_ex_set_header(
+        d, find.projectors ? "Find my Projector" : "Find my TV", 64, 2, AlignCenter, AlignTop);
+    dialog_ex_set_text(d, "Sends each brand's\nPower in turn", 64, 30, AlignCenter, AlignCenter);
+    dialog_ex_set_center_button_text(d, "Start");
+    dialog_ex_set_result_callback(d, find_start_result);
+    dialog_ex_set_context(d, infrared);
+    view_dispatcher_switch_to_view(infrared->view_dispatcher, InfraredViewDialogEx);
+}
+
+static void find_stop(void) {
+    if(find.timer) {
+        furi_timer_stop(find.timer);
+        furi_timer_free(find.timer);
+        find.timer = NULL;
+    }
+    for(size_t i = 0; i < find.count; i++) furi_string_free(find.names[i]);
+    find.count = 0;
+}
+
+static void find_path(FuriString* out, size_t i) {
+    furi_string_printf(out, "%s/%s", find.folder, furi_string_get_cstr(find.names[i]));
+}
+
+// Sends the brand file's Power button (first match of the common spellings).
+static void find_send_power(size_t i) {
+    static const char* const NAMES[] = {"Power", "POWER", "power", "Power_on", "On"};
+    FuriString* path = furi_string_alloc();
+    find_path(path, i);
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    FlipperFormat* ff = flipper_format_buffered_file_alloc(storage);
+    InfraredSignal* signal = infrared_signal_alloc();
+    bool sent = false;
+    for(size_t n = 0; n < COUNT_OF(NAMES) && !sent; n++) {
+        if(!flipper_format_buffered_file_open_existing(ff, furi_string_get_cstr(path))) break;
+        if(infrared_signal_search_by_name_and_read(signal, ff, NAMES[n]) == InfraredErrorCodeNone) {
+            infrared_signal_transmit(signal);
+            sent = true;
+        }
+        flipper_format_buffered_file_close(ff);
+    }
+    infrared_signal_free(signal);
+    flipper_format_free(ff);
+    furi_record_close(RECORD_STORAGE);
+    furi_string_free(path);
+}
+
+static void find_step(InfraredApp* infrared) {
+    static char head[24], brand[40];
+    snprintf(head, sizeof(head), "Trying %u/%u", (unsigned)find.idx + 1, (unsigned)find.count);
+    // "Samsung.ir" -> "Samsung"
+    strlcpy(brand, furi_string_get_cstr(find.names[find.idx]), sizeof(brand));
+    char* dot = strrchr(brand, '.');
+    if(dot) *dot = '\0';
+    DialogEx* d = infrared->dialog_ex;
+    dialog_ex_reset(d);
+    dialog_ex_set_header(d, head, 64, 2, AlignCenter, AlignTop);
+    dialog_ex_set_text(d, brand, 64, 26, AlignCenter, AlignCenter);
+    dialog_ex_set_center_button_text(d, "Works!");
+    dialog_ex_set_result_callback(d, find_result);
+    dialog_ex_set_context(d, infrared);
+    view_dispatcher_switch_to_view(infrared->view_dispatcher, InfraredViewDialogEx);
+    find_send_power(find.idx);
+}
+
+static int find_cmp(const void* a, const void* b) {
+    return strcasecmp(
+        furi_string_get_cstr(*(FuriString* const*)a), furi_string_get_cstr(*(FuriString* const*)b));
+}
+
+static void find_list(void) {
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* dir = storage_file_alloc(storage);
+    char name[64];
+    FileInfo fi;
+    if(storage_dir_open(dir, find.folder)) {
+        while(find.count < FIND_MAX_BRANDS && storage_dir_read(dir, &fi, name, sizeof(name))) {
+            size_t len = strlen(name);
+            if(!file_info_is_dir(&fi) && len > 3 && !strcasecmp(name + len - 3, ".ir"))
+                find.names[find.count++] = furi_string_alloc_set(name);
+        }
+    }
+    storage_dir_close(dir);
+    storage_file_free(dir);
+    furi_record_close(RECORD_STORAGE);
+    qsort(find.names, find.count, sizeof(find.names[0]), find_cmp);
+}
+
+void infrared_scene_find_remote_on_enter(void* context) {
+    InfraredApp* infrared = context;
+    uint32_t state = scene_manager_get_scene_state(infrared->scene_manager, InfraredSceneFindRemote);
+    if(state & FIND_STATE_OPENED) {
+        // back from the opened remote: leave the search, don't start over
+        scene_manager_previous_scene(infrared->scene_manager);
+        return;
+    }
+    find.projectors = state & FIND_STATE_PROJECTORS;
+    find.folder = find.projectors ? EXT_PATH("infrared/Projectors") : EXT_PATH("infrared/TVs");
+    find.count = 0;
+    find.idx = 0;
+    find_list();
+    if(!find.count) {
+        infrared_show_error_message(infrared, "No remotes yet.\nRun WiFi > Update SD");
+        scene_manager_previous_scene(infrared->scene_manager);
+        return;
+    }
+    find_prompt(infrared); // wait for Start; don't blast Power on enter
+}
+
+bool infrared_scene_find_remote_on_event(void* context, SceneManagerEvent event) {
+    InfraredApp* infrared = context;
+    if(event.type != SceneManagerEventTypeCustom) return false; // Back: default = leave
+    if(event.event == FIND_EVT_START && find.count && !find.timer) {
+        find.idx = 0;
+        find.timer = furi_timer_alloc(find_tick, FuriTimerTypePeriodic, infrared);
+        furi_timer_start(find.timer, furi_ms_to_ticks(infrared_scan_step_ms()));
+        find_step(infrared);
+        return true;
+    }
+    if(event.event == FIND_EVT_NEXT && find.count) {
+        if(find.idx + 1 >= find.count) {
+            scene_manager_previous_scene(infrared->scene_manager); // tried them all
+        } else {
+            find.idx++;
+            find_step(infrared);
+        }
+        return true;
+    }
+    if(event.event == FIND_EVT_FOUND && find.count) {
+        if(find.timer) furi_timer_stop(find.timer);
+        find_path(infrared->file_path, find.idx);
+        if(!INFRARED_ERROR_PRESENT(
+               infrared_remote_load(infrared->remote, furi_string_get_cstr(infrared->file_path)))) {
+            uint32_t state =
+                scene_manager_get_scene_state(infrared->scene_manager, InfraredSceneFindRemote);
+            scene_manager_set_scene_state(
+                infrared->scene_manager, InfraredSceneFindRemote, state | FIND_STATE_OPENED);
+            scene_manager_next_scene(infrared->scene_manager, InfraredSceneRemote);
+        } else {
+            infrared_show_error_message(infrared, "Failed to load\n%s", furi_string_get_cstr(infrared->file_path));
+            scene_manager_previous_scene(infrared->scene_manager);
+        }
+        return true;
+    }
+    return false;
+}
+
+void infrared_scene_find_remote_on_exit(void* context) {
+    InfraredApp* infrared = context;
+    find_stop();
+    dialog_ex_reset(infrared->dialog_ex);
+}
