+# M5StickC Plus2: drop apps for hardware it doesn't have / demos, to free firmware
+# space (the 3 MB app slot is ~97% full). No RFID coil (BOARD_HAS_RFID 0), no second
+# firmware slot for other_os in the single-app layout, examples are demo code.
+_plus2_dead_weight = {"lfrfid", "other_os", "example_apps_data", "example_apps_assets",
+                      "example_number_input"}
+if _board == "m5stickcplus2":
+    APPS = [a for a in APPS if a not in _plus2_dead_weight]
+
