diff --git a/applications/main/infrared/infrared_scan.c b/applications/main/infrared/infrared_scan.c
new file mode 100644
index 0000000..9339124
--- /dev/null
+++ b/applications/main/infrared/infrared_scan.c
@@ -0,0 +1,47 @@
+// Shared speed for the "Find my AC / TV / Projector" searches: how long each brand
+// is tried before the next one (time to see the device react and press OK).
+#include "infrared_app_i.h"
+
+#define SCAN_SPEED_FILE EXT_PATH("infrared/.scan_speed")
+
+static const char* const SCAN_NAMES[] = {"Default", "Medium", "Fast"};
+static const uint32_t SCAN_STEP_MS[] = {2500, 1500, 800};
+static uint8_t scan_speed = 0;
+static bool scan_loaded = false;
+
+static void infrared_scan_io(bool save) {
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* f = storage_file_alloc(storage);
+    if(save) {
+        if(storage_file_open(f, SCAN_SPEED_FILE, FSAM_WRITE, FSOM_CREATE_ALWAYS))
+            storage_file_write(f, &scan_speed, 1);
+    } else if(storage_file_open(f, SCAN_SPEED_FILE, FSAM_READ, FSOM_OPEN_EXISTING)) {
+        uint8_t v = 0;
+        if(storage_file_read(f, &v, 1) == 1 && v < COUNT_OF(SCAN_NAMES)) scan_speed = v;
+    }
+    storage_file_close(f);
+    storage_file_free(f);
+    furi_record_close(RECORD_STORAGE);
+}
+
+static void infrared_scan_load(void) {
+    if(scan_loaded) return;
+    infrared_scan_io(false);
+    scan_loaded = true;
+}
+
+uint32_t infrared_scan_step_ms(void) {
+    infrared_scan_load();
+    return SCAN_STEP_MS[scan_speed];
+}
+
+const char* infrared_scan_speed_name(void) {
+    infrared_scan_load();
+    return SCAN_NAMES[scan_speed];
+}
+
+void infrared_scan_speed_cycle(void) {
+    infrared_scan_load();
+    scan_speed = (uint8_t)((scan_speed + 1) % COUNT_OF(SCAN_NAMES));
+    infrared_scan_io(true);
+}
