@@ -203,3 +217,116 @@ FuriHalRtcLocaleUnits furi_hal_rtc_get_locale_units(void) {
 void furi_hal_rtc_set_locale_units(FuriHalRtcLocaleUnits format) {
     furi_hal_rtc.locale_units = format;
 }
+
+// ---------------------------------------------------------------------------
+// Real clock: Israel time zone, battery-backed BM8563 chip (M5StickC Plus2) and
+// NTP. System time is UTC; the TZ rule turns it into Jerusalem local time with
+// summer time switching automatically. The BM8563 keeps counting while the
+// stick is powered off, so the clock is right at boot even without WiFi.
+// ---------------------------------------------------------------------------
+
+// Asia/Jerusalem (tzdata POSIX rule): IST UTC+2, IDT from the Friday before the
+// last Sunday of March 02:00 to the last Sunday of October 02:00
+#define FURI_HAL_RTC_MIN_VALID 1704067200 // 2024-01-01: anything older = never set
+
+#if defined(BOARD_HAS_BM8563) && BOARD_HAS_BM8563
+#include <driver/i2c.h>
+#define BM8563_ADDR 0x51
+#define BM8563_PORT I2C_NUM_1 // shared with the IMU (same pins, same config)
+
+static bool bm8563_bus(void) {
+    static bool ready = false;
+    if(ready) return true;
+    const i2c_config_t conf = {
+        .mode = I2C_MODE_MASTER,
+        .sda_io_num = BOARD_PIN_IMU_SDA,
+        .scl_io_num = BOARD_PIN_IMU_SCL,
+        .sda_pullup_en = GPIO_PULLUP_ENABLE,
+        .scl_pullup_en = GPIO_PULLUP_ENABLE,
+        .master.clk_speed = 400000,
+    };
+    esp_err_t err = i2c_driver_install(BM8563_PORT, conf.mode, 0, 0, 0);
+    if(err != ESP_OK && err != ESP_ERR_INVALID_STATE) return false;
+    ready = i2c_param_config(BM8563_PORT, &conf) == ESP_OK;
+    return ready;
+}
+
+static uint8_t bcd2bin(uint8_t v) {
+    return (uint8_t)((v >> 4) * 10 + (v & 0x0F));
+}
+static uint8_t bin2bcd(uint8_t v) {
+    return (uint8_t)(((v / 10) << 4) | (v % 10));
+}
+
+// days since 1970-01-01 for a civil date (no timegm() in newlib)
+static int64_t days_from_civil(int y, unsigned m, unsigned d) {
+    y -= m <= 2;
+    const int era = (y >= 0 ? y : y - 399) / 400;
+    const unsigned yoe = (unsigned)(y - era * 400);
+    const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    return (int64_t)era * 146097 + (int64_t)doe - 719468;
+}
+
+static bool bm8563_read(time_t* out) {
+    uint8_t reg = 0x02, r[7];
+    if(!bm8563_bus() ||
+       i2c_master_write_read_device(BM8563_PORT, BM8563_ADDR, &reg, 1, r, 7, pdMS_TO_TICKS(50)) !=
+           ESP_OK)
+        return false;
+    if(r[0] & 0x80) return false; // VL flag: clock lost power, time invalid
+    // century bit set = 19xx (M5Stack / Bruce convention, so time set there reads right)
+    int year = ((r[5] & 0x80) ? 1900 : 2000) + bcd2bin(r[6]);
+    int64_t days = days_from_civil(year, bcd2bin(r[5] & 0x1F), bcd2bin(r[3] & 0x3F));
+    *out = (time_t)(days * 86400 + bcd2bin(r[2] & 0x3F) * 3600 + bcd2bin(r[1] & 0x7F) * 60 +
+                    bcd2bin(r[0] & 0x7F));
+    return *out >= FURI_HAL_RTC_MIN_VALID;
+}
+
+static void bm8563_write(time_t t) {
+    struct tm u;
+    gmtime_r(&t, &u);
+    uint8_t w[8] = {
+        0x02,
+        bin2bcd((uint8_t)u.tm_sec), // VL bit cleared
+        bin2bcd((uint8_t)u.tm_min),
+        bin2bcd((uint8_t)u.tm_hour),
+        bin2bcd((uint8_t)u.tm_mday),
+        (uint8_t)u.tm_wday,
+        (uint8_t)(bin2bcd((uint8_t)(u.tm_mon + 1)) | (u.tm_year < 100 ? 0x80 : 0)),
+        bin2bcd((uint8_t)(u.tm_year % 100)),
+    };
+    if(bm8563_bus())
+        i2c_master_write_to_device(BM8563_PORT, BM8563_ADDR, w, sizeof(w), pdMS_TO_TICKS(50));
+}
+#else
+static bool bm8563_read(time_t* out) {
+    UNUSED(out);
+    return false;
+}
+static void bm8563_write(time_t t) {
+    UNUSED(t);
+}
+#endif
+
+static void furi_hal_rtc_set_system_time(time_t t) {
+    struct timeval tv = {.tv_sec = t, .tv_usec = 0};
+    settimeofday(&tv, NULL);
+    furi_hal_rtc.time_offset = 0;
+}
+
+static void furi_hal_rtc_ntp_synced(struct timeval* tv) {
+    furi_hal_rtc.time_offset = 0;
+    bm8563_write(tv->tv_sec); // so the clock survives the next power-off
+}
+
+void furi_hal_rtc_ntp_start(void) {
+    static bool started = false;
+    if(started) return;
+    started = true;
+    esp_sntp_setoperatingmode(ESP_SNTP_OPMODE_POLL);
+    esp_sntp_setservername(0, "pool.ntp.org");
+    esp_sntp_setservername(1, "time.google.com");
+    sntp_set_time_sync_notification_cb(furi_hal_rtc_ntp_synced);
+    esp_sntp_init(); // re-syncs every hour while WiFi stays up
+}
