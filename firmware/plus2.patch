index 0d4622a..e165baf 100644
--- a/main/app_main.c
+++ b/main/app_main.c
@@ -5,6 +5,8 @@
 #include <flipper_application/elf/elf_file.h>
 
 #include <esp_log.h>
+#include <esp_pm.h>
