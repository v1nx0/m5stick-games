diff --git a/applications_user/sky_hopper_color/sky_hopper_color.c b/applications_user/sky_hopper_color/sky_hopper_color.c
new file mode 100644
index 0000000..779ced7
--- /dev/null
+++ b/applications_user/sky_hopper_color/sky_hopper_color.c
@@ -0,0 +1,354 @@
+// Sky Hopper Color: full-color, full-screen flying game for the M5StickC Plus2.
+// Original art, all drawn in code: a little robot drone hops through glowing crystal
+// pillars over parallax hills. A = flap / start, Power (Back) = quit.
+// Draws straight to the panel (like Doom): gui_direct_draw_acquire() pauses the GUI,
+// each 15-row band is rendered into a small DMA buffer and sent - no full framebuffer.
+#include <furi.h>
+#include <furi_hal.h>
+#include <gui/gui.h>
+#include <input/input.h>
+#include <storage/storage.h>
+#include <esp_lcd_panel_ops.h>
+#include <esp_heap_caps.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define W 240
+#define H 135
+#define BAND 15
+#define GROUND_Y 121
+#define PILLARS 3
+#define PILLAR_W 26
+#define GAP 50
+#define SPACING 104
+#define HERO_X 56
+#define HERO_R 7
+#define BEST_FILE EXT_PATH("apps_data/sky_hopper_color.best")
+
+// RGB888 -> byte-swapped RGB565 (ST7789 byte order used by the display driver)
+static inline uint16_t rgb(int r, int g, int b) {
+    uint16_t c = (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+    return (uint16_t)((c >> 8) | (c << 8));
+}
+
+typedef enum { StateReady, StatePlay, StateOver } State;
+
+typedef struct {
+    float y, vy;
+    float px[PILLARS];
+    int gap_y[PILLARS];
+    bool scored[PILLARS];
+    int score, best;
+    State state;
+    uint32_t frame, over_frame; // over_frame: when the crash happened
+    float scroll;
+} Game;
+
+// ---- tiny 3x5 font (digits + the letters we print) ----
+static const char FONT_CHARS[] = "0123456789ABEFGLMOPRSTVY";
+static const uint8_t FONT[][5] = {
+    {7, 5, 5, 5, 7}, {2, 6, 2, 2, 7}, {7, 1, 7, 4, 7}, {7, 1, 7, 1, 7}, {5, 5, 7, 1, 1},
+    {7, 4, 7, 1, 7}, {7, 4, 7, 5, 7}, {7, 1, 1, 1, 1}, {7, 5, 7, 5, 7}, {7, 5, 7, 1, 7},
+    {2, 5, 7, 5, 5}, // A
+    {6, 5, 6, 5, 6}, // B
+    {7, 4, 6, 4, 7}, // E
+    {7, 4, 6, 4, 4}, // F
+    {7, 4, 5, 5, 7}, // G
+    {4, 4, 4, 4, 7}, // L
+    {5, 7, 7, 5, 5}, // M
+    {7, 5, 5, 5, 7}, // O
+    {7, 5, 7, 4, 4}, // P
+    {6, 5, 6, 5, 5}, // R
+    {7, 4, 7, 1, 7}, // S
+    {7, 2, 2, 2, 2}, // T
+    {5, 5, 5, 5, 2}, // V
+    {5, 5, 2, 2, 2}, // Y
+};
+
+typedef struct {
+    const char* s;
+    int x, y, scale;
+    uint16_t color;
+} Text;
+
+static int glyph_index(char c) {
+    const char* p = strchr(FONT_CHARS, c);
+    return (p && c) ? (int)(p - FONT_CHARS) : -1;
+}
+
+static int text_width(const char* s, int scale) {
+    return (int)strlen(s) * 4 * scale - scale;
+}
+
+// Draws text pixels that fall inside band rows [y0, y0+h)
+static void band_text(uint16_t* buf, int y0, int h, const Text* t) {
+    for(int i = 0; t->s[i]; i++) {
+        int g = glyph_index(t->s[i]);
+        if(g < 0) continue;
+        int gx0 = t->x + i * 4 * t->scale;
+        for(int gy = 0; gy < 5; gy++) {
+            for(int sy = 0; sy < t->scale; sy++) {
+                int y = t->y + gy * t->scale + sy - y0;
+                if(y < 0 || y >= h) continue;
+                for(int gx = 0; gx < 3; gx++) {
+                    if(!(FONT[g][gy] & (4 >> gx))) continue;
+                    for(int sx = 0; sx < t->scale; sx++) {
+                        int x = gx0 + gx * t->scale + sx;
+                        if(x >= 0 && x < W) buf[y * W + x] = t->color;
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ---- world ----
+static uint16_t sky_row[H];
+static uint8_t far_hill[W], near_hill[W];
+
+static void build_sky(void) {
+    for(int y = 0; y < H; y++) { // deep blue at the top, warm pale near the horizon
+        float t = (float)y / GROUND_Y;
+        if(t > 1) t = 1;
+        sky_row[y] = rgb((int)(30 + 190 * t), (int)(80 + 140 * t), (int)(190 + 50 * t));
+    }
+}
+
+static void build_hills(float scroll) {
+    for(int x = 0; x < W; x++) {
+        float fx = x + scroll * 0.25f, nx = x + scroll * 0.6f;
+        far_hill[x] = (uint8_t)(92 + 9 * sinf(fx * 0.031f) + 5 * sinf(fx * 0.083f));
+        near_hill[x] = (uint8_t)(106 + 6 * sinf(nx * 0.047f + 1.3f) + 3 * sinf(nx * 0.13f));
+    }
+}
+
+static void reset(Game* g) {
+    g->y = H / 2.0f;
+    g->vy = 0;
+    g->score = 0;
+    g->state = StateReady;
+    for(int i = 0; i < PILLARS; i++) {
+        g->px[i] = W + 30 + i * SPACING;
+        g->gap_y[i] = 22 + rand() % (GROUND_Y - GAP - 34);
+        g->scored[i] = false;
+    }
+}
+
+static void step(Game* g) {
+    g->frame++;
+    if(g->state != StateOver) g->scroll += 2.0f;
+    if(g->state == StateReady) { // hover until the first flap
+        g->y = H / 2.0f + 3 * sinf(g->frame * 0.15f);
+        return;
+    }
+    if(g->state != StatePlay) return;
+    g->vy += 0.32f;
+    if(g->vy > 6) g->vy = 6;
+    g->y += g->vy;
+    if(g->y - HERO_R < 0) g->y = HERO_R, g->vy = 0;
+    if(g->y + HERO_R >= GROUND_Y) g->state = StateOver; // over_frame set at end of step
+    for(int i = 0; i < PILLARS; i++) {
+        g->px[i] -= 2.0f;
+        if(g->px[i] + PILLAR_W < 0) {
+            g->px[i] += PILLARS * SPACING;
+            g->gap_y[i] = 22 + rand() % (GROUND_Y - GAP - 34);
+            g->scored[i] = false;
+        }
+        bool in_x = HERO_X + HERO_R - 2 > g->px[i] && HERO_X - HERO_R + 2 < g->px[i] + PILLAR_W;
+        bool in_gap = g->y - HERO_R + 2 > g->gap_y[i] && g->y + HERO_R - 2 < g->gap_y[i] + GAP;
+        if(in_x && !in_gap) g->state = StateOver;
+        if(!g->scored[i] && g->px[i] + PILLAR_W < HERO_X - HERO_R) {
+            g->scored[i] = true;
+            g->score++;
+        }
+    }
+    if(g->state == StateOver) {
+        g->over_frame = g->frame;
+        if(g->score > g->best) g->best = g->score;
+    }
+}
+
+// background + pillars for one band
+static void band_world(const Game* g, uint16_t* buf, int y0, int h) {
+    const uint16_t far_c = rgb(90, 120, 170), near_c = rgb(60, 140, 110);
+    const uint16_t grass = rgb(70, 170, 80), dirt_a = rgb(150, 105, 60), dirt_b = rgb(130, 90, 50);
+    for(int r = 0; r < h; r++) {
+        int y = y0 + r;
+        uint16_t* row = &buf[r * W];
+        for(int x = 0; x < W; x++) {
+            uint16_t c = sky_row[y];
+            if(y >= GROUND_Y) {
+                c = y < GROUND_Y + 3 ? grass :
+                    (((x + (int)g->scroll) / 8 + y / 4) & 1) ? dirt_a : dirt_b;
+            } else if(y >= near_hill[x]) {
+                c = near_c;
+            } else if(y >= far_hill[x]) {
+                c = far_c;
+            }
+            row[x] = c;
+        }
+        // clouds: soft white ellipses drifting slowly
+        for(int k = 0; k < 3; k++) {
+            int cx = (int)(k * 97 + 300 - fmodf(g->scroll * 0.15f, 380)) % 380 - 70;
+            int cy = 18 + k * 13;
+            int dy = y - cy;
+            if(dy < -6 || dy > 6) continue;
+            int half = (int)(22 * sqrtf(1 - (dy * dy) / 40.0f));
+            for(int x = cx - half; x <= cx + half; x++)
+                if(x >= 0 && x < W) row[x] = rgb(245, 248, 255);
+        }
+        // crystal pillars: violet-to-teal shading, bright edge, darker cap
+        for(int i = 0; i < PILLARS; i++) {
+            int x0 = (int)g->px[i];
+            bool in_gap = y >= g->gap_y[i] && y < g->gap_y[i] + GAP;
+            if(in_gap || y >= GROUND_Y || x0 >= W || x0 + PILLAR_W <= 0) continue;
+            bool cap = y >= g->gap_y[i] - 6 && y < g->gap_y[i] + GAP + 6;
+            for(int dx = cap ? -3 : 0; dx < PILLAR_W + (cap ? 3 : 0); dx++) {
+                int x = x0 + dx;
+                if(x < 0 || x >= W) continue;
+                int t = dx * 255 / PILLAR_W;
+                uint16_t c = cap ? rgb(90 + t / 3, 60, 170) : rgb(110 - t / 4, 80 + t / 2, 200 - t / 4);
+                if(dx == 2 || dx == 3) c = rgb(220, 240, 255); // shine stripe
+                row[x] = c;
+            }
+        }
+    }
+}
+
+// robot drone: silver body, cyan visor, orange antenna light, spinning rotor
+static void band_hero(const Game* g, uint16_t* buf, int y0, int h) {
+    int cy = (int)g->y;
+    bool rotor_a = (g->frame / 2) & 1;
+    for(int r = 0; r < h; r++) {
+        int y = y0 + r, dy = y - cy;
+        if(dy < -HERO_R - 5 || dy > HERO_R) continue;
+        uint16_t* row = &buf[r * W];
+        if(dy == -HERO_R - 4) { // rotor blade
+            int half = rotor_a ? 9 : 4;
+            for(int x = HERO_X - half; x <= HERO_X + half; x++) row[x] = rgb(60, 60, 70);
+            continue;
+        }
+        if(dy < -HERO_R) { // mast + light
+            row[HERO_X] = dy == -HERO_R - 3 ? rgb(255, 140, 40) : rgb(80, 80, 90);
+            continue;
+        }
+        int half = (int)sqrtf((float)(HERO_R * HERO_R - dy * dy));
+        for(int x = HERO_X - half; x <= HERO_X + half; x++) {
+            int dx = x - HERO_X;
+            uint16_t c = (dx + dy < -4) ? rgb(235, 240, 245) : rgb(170, 180, 195); // lit side
+            if(dy >= -3 && dy <= 0 && dx >= -1 && dx <= 5) c = rgb(40, 230, 240); // visor
+            if(dx == half || -dx == half) c = rgb(70, 75, 90);                     // outline
+            row[x] = c;
+        }
+    }
+}
+
+static void render(const Game* g, esp_lcd_panel_handle_t panel, uint16_t* buf) {
+    char score[8], best[16];
+    snprintf(score, sizeof(score), "%d", g->score);
+    snprintf(best, sizeof(best), "BEST %d", g->best);
+    const uint16_t white = rgb(255, 255, 255), shade = rgb(30, 40, 70);
+    Text texts[6];
+    int n = 0;
+    int sw = text_width(score, 3);
+    texts[n++] = (Text){score, W / 2 - sw / 2 + 2, 8, 3, shade}; // drop shadow
+    texts[n++] = (Text){score, W / 2 - sw / 2, 6, 3, white};
+    if(g->state == StateReady) {
+        const char* m = "PRESS A";
+        texts[n++] = (Text){m, W / 2 - text_width(m, 2) / 2, 92, 2, white};
+    } else if(g->state == StateOver) {
+        const char* m = "GAME OVER";
+        texts[n++] = (Text){m, W / 2 - text_width(m, 3) / 2, 40, 3, rgb(255, 220, 90)};
+        texts[n++] = (Text){best, W / 2 - text_width(best, 2) / 2, 66, 2, white};
+    }
+    furi_hal_spi_bus_lock();
+    for(int y0 = 0; y0 < H; y0 += BAND) {
+        int h = H - y0 < BAND ? H - y0 : BAND;
+        band_world(g, buf, y0, h);
+        band_hero(g, buf, y0, h);
+        for(int i = 0; i < n; i++) band_text(buf, y0, h, &texts[i]);
+        esp_lcd_panel_draw_bitmap(panel, 0, y0, W, y0 + h, buf);
+    }
+    furi_hal_spi_bus_unlock();
+}
+
+static void best_io(Game* g, bool save) {
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* f = storage_file_alloc(storage);
+    if(save) {
+        storage_common_mkdir(storage, EXT_PATH("apps_data"));
+        if(storage_file_open(f, BEST_FILE, FSAM_WRITE, FSOM_CREATE_ALWAYS))
+            storage_file_write(f, &g->best, sizeof(g->best));
+    } else if(storage_file_open(f, BEST_FILE, FSAM_READ, FSOM_OPEN_EXISTING)) {
+        storage_file_read(f, &g->best, sizeof(g->best));
+    }
+    storage_file_close(f);
+    storage_file_free(f);
+    furi_record_close(RECORD_STORAGE);
+}
+
+static void input_cb(const void* value, void* ctx) {
+    const InputEvent* e = value;
+    if(e->type == InputTypePress || e->type == InputTypeShort)
+        furi_message_queue_put(ctx, e, 0);
+}
+
+int32_t sky_hopper_color_app(void* p) {
+    UNUSED(p);
+    esp_lcd_panel_handle_t panel = furi_hal_display_get_panel_handle();
+    if(!panel || furi_hal_display_get_h_res() != W || furi_hal_display_get_v_res() != H)
+        return 0; // made for the Plus2's 240x135 panel
+    uint16_t* buf = heap_caps_malloc(W * BAND * sizeof(uint16_t), MALLOC_CAP_DMA);
+    if(!buf) return 0;
+
+    Game* g = malloc(sizeof(Game));
+    memset(g, 0, sizeof(Game));
+    srand(furi_get_tick());
+    best_io(g, false);
+    build_sky();
+    reset(g);
+
+    FuriMessageQueue* q = furi_message_queue_alloc(8, sizeof(InputEvent));
+    FuriPubSub* input = furi_record_open(RECORD_INPUT_EVENTS);
+    FuriPubSubSubscription* sub = furi_pubsub_subscribe(input, input_cb, q);
+    Gui* gui = furi_record_open(RECORD_GUI);
+    gui_direct_draw_acquire(gui);
+
+    int saved_best = g->best;
+    for(bool run = true; run;) {
+        uint32_t t0 = furi_get_tick();
+        InputEvent e;
+        while(furi_message_queue_get(q, &e, 0) == FuriStatusOk) {
+            if(e.key == InputKeyBack && e.type == InputTypeShort) run = false;
+            if(e.key == InputKeyOk && e.type == InputTypePress) {
+                // ~0.6 s after the crash before A restarts (no accidental instant restart)
+                if(g->state == StateOver && g->frame - g->over_frame > 20) {
+                    reset(g);
+                } else if(g->state != StateOver) {
+                    g->state = StatePlay;
+                    g->vy = -4.4f; // flap
+                }
+            }
+        }
+        if(g->state == StateOver && g->best != saved_best) {
+            best_io(g, true);
+            saved_best = g->best;
+        }
+        step(g);
+        build_hills(g->scroll);
+        render(g, panel, buf);
+        uint32_t spent = furi_get_tick() - t0, frame = furi_ms_to_ticks(33); // ~30 fps
+        if(spent < frame) furi_delay_tick(frame - spent);
+    }
+
+    gui_direct_draw_release(gui);
+    furi_hal_display_top_bar_invalidate(); // we drew over the top bar
+    furi_record_close(RECORD_GUI);
+    furi_pubsub_unsubscribe(input, sub);
+    furi_record_close(RECORD_INPUT_EVENTS);
+    furi_message_queue_free(q);
+    heap_caps_free(buf);
+    free(g);
+    return 0;
+}
