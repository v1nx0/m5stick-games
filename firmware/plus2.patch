diff --git a/applications/main/infrared/scenes/infrared_scene_universal_ac_full.c b/applications/main/infrared/scenes/infrared_scene_universal_ac_full.c
new file mode 100644
index 0000000..3f695bd
--- /dev/null
+++ b/applications/main/infrared/scenes/infrared_scene_universal_ac_full.c
@@ -0,0 +1,292 @@
+#include "../infrared_app_i.h" // IWYU pragma: keep
+#include <irac.h>
+
+// AC Full: pick the brand, then power / mode / temperature / fan, like the AC's own
+// remote. AC remotes send the whole state with every press, so the frame is built by
+// IRremoteESP8266's IRac (components/irac) for the chosen brand's protocol. Each change
+// is sent right away; the brand choice is saved on the stick.
+
+typedef enum { AcBrandRow, AcPower, AcMode, AcTemp, AcFan, AcSend } AcItem;
+
+#define AC_EVT_SEND        0x100u
+#define AC_EVT_OPEN_BRANDS 0x101u
+#define AC_EVT_BRAND_BASE  0x1000u
+#define AC_EVT_SCAN_START  0x102u
+#define AC_EVT_SCAN_NEXT   0x103u
+#define AC_EVT_SCAN_FOUND  0x104u
+#define AC_BRAND_FILE      EXT_PATH("infrared/.ac_brand")
+#define AC_TEMP_MIN        16
+#define AC_TEMP_MAX        30
+#define AC_MAX_TIMINGS     1024
+
+static const char* const AC_POWER[] = {"On", "Off"};
+static const char* const AC_MODE[] = {"Cool", "Heat", "Dry", "Auto", "Fan"};
+static const char* const AC_FAN[] = {"Auto", "Low", "Med", "High"};
+
+static struct {
+    uint16_t brand;
+    uint8_t power, mode, temp_idx, fan; // indexes into the tables above
+    bool loaded;
+    bool picking; // brand list is showing
+    bool scanning; // "Find my AC" is stepping through the brands
+    uint16_t scan_idx;
+} ac = {0, 0, 0, 24 - AC_TEMP_MIN, 0, false, false, false, 0};
+static FuriTimer* ac_scan_timer = NULL;
+
+// Saved by NAME: the brand list is generated from the library, so an index could point
+// at a different brand after an update that adds or reorders entries.
+static void ac_brand_io(bool save) {
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* f = storage_file_alloc(storage);
+    if(save) {
+        const char* name = irac_brand_name(ac.brand);
+        if(storage_file_open(f, AC_BRAND_FILE, FSAM_WRITE, FSOM_CREATE_ALWAYS))
+            storage_file_write(f, name, strlen(name));
+    } else if(storage_file_open(f, AC_BRAND_FILE, FSAM_READ, FSOM_OPEN_EXISTING)) {
+        char name[48] = {0};
+        storage_file_read(f, name, sizeof(name) - 1);
+        for(size_t i = 0; i < irac_brand_count(); i++)
+            if(!strcmp(irac_brand_name(i), name)) {
+                ac.brand = (uint16_t)i;
+                break;
+            }
+    }
+    storage_file_close(f);
+    storage_file_free(f);
+    furi_record_close(RECORD_STORAGE);
+}
+
+static void ac_full_send_brand(InfraredApp* infrared, uint16_t brand, bool power) {
+    uint32_t* timings = malloc(sizeof(uint32_t) * AC_MAX_TIMINGS);
+    size_t n = 0;
+    uint32_t freq = 0;
+    bool ok = irac_build(
+        brand,
+        power,
+        (IracMode)ac.mode,
+        (uint8_t)(ac.temp_idx + AC_TEMP_MIN),
+        (IracFan)ac.fan,
+        timings,
+        AC_MAX_TIMINGS,
+        &n,
+        &freq);
+    if(ok) {
+        InfraredSignal* signal = infrared_signal_alloc();
+        infrared_signal_set_raw_signal(signal, timings, n, freq, 0.33f);
+        infrared_signal_transmit(signal);
+        infrared_signal_free(signal);
+        notification_message(infrared->notifications, &sequence_blink_cyan_10);
+    } else {
+        notification_message(infrared->notifications, &sequence_error);
+    }
+    free(timings);
+}
+
+static void ac_full_send(InfraredApp* infrared) {
+    ac_full_send_brand(infrared, ac.brand, ac.power == 0);
+}
+
+static void ac_full_set_text(VariableItem* item, AcItem which) {
+    char buf[8];
+    switch(which) {
+    case AcBrandRow:
+        variable_item_set_current_value_text(
+            item, irac_brand_count() ? irac_brand_name(ac.brand) : "no AC library");
+        break;
+    case AcPower:
+        variable_item_set_current_value_text(item, AC_POWER[ac.power]);
+        break;
+    case AcMode:
+        variable_item_set_current_value_text(item, AC_MODE[ac.mode]);
+        break;
+    case AcTemp:
+        snprintf(buf, sizeof(buf), "%u C", (unsigned)(ac.temp_idx + AC_TEMP_MIN));
+        variable_item_set_current_value_text(item, buf);
+        break;
+    case AcFan:
+        variable_item_set_current_value_text(item, AC_FAN[ac.fan]);
+        break;
+    default:
+        break;
+    }
+}
+
+static void ac_full_changed(VariableItem* item) {
+    InfraredApp* infrared = variable_item_get_context(item);
+    uint8_t v = variable_item_get_current_value_index(item);
+    AcItem which = (AcItem)variable_item_list_get_selected_item_index(infrared->var_item_list);
+    if(which == AcPower) ac.power = v;
+    if(which == AcMode) ac.mode = v;
+    if(which == AcTemp) ac.temp_idx = v;
+    if(which == AcFan) ac.fan = v;
+    ac_full_set_text(item, which);
+    // changing a setting turns the AC on with it, like a real remote
+    if(which != AcPower && ac.power == 1) {
+        ac.power = 0;
+        VariableItem* p = variable_item_list_get(infrared->var_item_list, AcPower);
+        variable_item_set_current_value_index(p, 0);
+        ac_full_set_text(p, AcPower);
+    }
+    view_dispatcher_send_custom_event(infrared->view_dispatcher, AC_EVT_SEND);
+}
+
+static void ac_full_enter(void* context, uint32_t index) {
+    InfraredApp* infrared = context;
+    view_dispatcher_send_custom_event(
+        infrared->view_dispatcher, index == AcBrandRow ? AC_EVT_OPEN_BRANDS : AC_EVT_SEND);
+}
+
+static void ac_brand_picked(void* context, uint32_t index) {
+    InfraredApp* infrared = context;
+    view_dispatcher_send_custom_event(infrared->view_dispatcher, AC_EVT_BRAND_BASE + index);
+}
+
+// --- Find my AC: send the current setting (turned On) with every brand in turn ---
+
+static void ac_scan_tick(void* context) {
+    InfraredApp* infrared = context;
+    view_dispatcher_send_custom_event(infrared->view_dispatcher, AC_EVT_SCAN_NEXT);
+}
+
+static void ac_scan_result(DialogExResult result, void* context) {
+    InfraredApp* infrared = context;
+    if(result == DialogExResultCenter)
+        view_dispatcher_send_custom_event(infrared->view_dispatcher, AC_EVT_SCAN_FOUND);
+}
+
+static void ac_scan_stop(void) {
+    if(ac_scan_timer) {
+        furi_timer_stop(ac_scan_timer);
+        furi_timer_free(ac_scan_timer);
+        ac_scan_timer = NULL;
+    }
+    ac.scanning = false;
+}
+
+// Sends brand scan_idx and shows it; the dialog's OK means "this one worked".
+static void ac_scan_step(InfraredApp* infrared) {
+    static char head[24];
+    DialogEx* d = infrared->dialog_ex;
+    dialog_ex_reset(d);
+    snprintf(head, sizeof(head), "Trying %u/%u", ac.scan_idx + 1, (unsigned)irac_brand_count());
+    dialog_ex_set_header(d, head, 64, 2, AlignCenter, AlignTop);
+    dialog_ex_set_text(d, irac_brand_name(ac.scan_idx), 64, 26, AlignCenter, AlignCenter);
+    dialog_ex_set_center_button_text(d, "Works!");
+    dialog_ex_set_result_callback(d, ac_scan_result);
+    dialog_ex_set_context(d, infrared);
+    view_dispatcher_switch_to_view(infrared->view_dispatcher, InfraredViewDialogEx);
+    ac_full_send_brand(infrared, ac.scan_idx, true);
+}
+
+static void ac_scan_start(void* context, uint32_t index) {
+    InfraredApp* infrared = context;
+    UNUSED(index);
+    view_dispatcher_send_custom_event(infrared->view_dispatcher, AC_EVT_SCAN_START);
+}
+
+static void ac_full_show_list(InfraredApp* infrared) {
+    VariableItemList* list = infrared->var_item_list;
+    variable_item_list_reset(list);
+    VariableItem* brand = variable_item_list_add(list, "Brand", 1, NULL, infrared);
+    ac_full_set_text(brand, AcBrandRow);
+    const struct {
+        const char* label;
+        uint8_t count, value;
+    } rows[] = {
+        {"Power", COUNT_OF(AC_POWER), ac.power},
+        {"Mode", COUNT_OF(AC_MODE), ac.mode},
+        {"Temp", AC_TEMP_MAX - AC_TEMP_MIN + 1, ac.temp_idx},
+        {"Fan", COUNT_OF(AC_FAN), ac.fan},
+    };
+    for(size_t i = 0; i < COUNT_OF(rows); i++) {
+        VariableItem* item =
+            variable_item_list_add(list, rows[i].label, rows[i].count, ac_full_changed, infrared);
+        variable_item_set_current_value_index(item, rows[i].value);
+        ac_full_set_text(item, (AcItem)(i + 1));
+    }
+    VariableItem* send = variable_item_list_add(list, "Send again", 1, NULL, infrared);
+    variable_item_set_current_value_text(send, "OK");
+    variable_item_list_set_enter_callback(list, ac_full_enter, infrared);
+    ac.picking = false;
+    view_dispatcher_switch_to_view(infrared->view_dispatcher, InfraredViewVariableList);
+}
+
+static void ac_full_show_brands(InfraredApp* infrared) {
+    Submenu* submenu = infrared->submenu;
+    submenu_reset(submenu);
+    submenu_set_header(submenu, "AC brand");
+    submenu_add_item(submenu, "Find my AC (try all)", 0xFFFF, ac_scan_start, infrared);
+    for(size_t i = 0; i < irac_brand_count(); i++)
+        submenu_add_item(submenu, irac_brand_name(i), i, ac_brand_picked, infrared);
+    submenu_set_selected_item(submenu, ac.brand);
+    ac.picking = true;
+    view_dispatcher_switch_to_view(infrared->view_dispatcher, InfraredViewSubmenu);
+}
+
+void infrared_scene_universal_ac_full_on_enter(void* context) {
+    InfraredApp* infrared = context;
+    if(!ac.loaded) {
+        ac_brand_io(false);
+        ac.loaded = true;
+    }
+    ac_full_show_list(infrared);
+}
+
+bool infrared_scene_universal_ac_full_on_event(void* context, SceneManagerEvent event) {
+    InfraredApp* infrared = context;
+    if(event.type == SceneManagerEventTypeBack && ac.scanning) {
+        ac_scan_stop(); // Back during the search: stop, back to the brand list
+        ac_full_show_brands(infrared);
+        return true;
+    }
+    if(event.type == SceneManagerEventTypeBack && ac.picking) {
+        ac_full_show_list(infrared); // Back in the brand list returns to the settings
+        return true;
+    }
+    if(event.type != SceneManagerEventTypeCustom) return false;
+    if(event.event == AC_EVT_SEND) {
+        if(irac_brand_count()) ac_full_send(infrared);
+    } else if(event.event == AC_EVT_SCAN_START) {
+        if(!irac_brand_count()) return true;
+        ac.picking = false;
+        ac.scanning = true;
+        ac.scan_idx = 0;
+        ac.power = 0; // the search turns the AC on
+        ac_scan_timer = furi_timer_alloc(ac_scan_tick, FuriTimerTypePeriodic, infrared);
+        furi_timer_start(ac_scan_timer, furi_ms_to_ticks(infrared_scan_step_ms()));
+        ac_scan_step(infrared);
+    } else if(event.event == AC_EVT_SCAN_NEXT) {
+        if(!ac.scanning) return true;
+        if(ac.scan_idx + 1u >= irac_brand_count()) {
+            ac_scan_stop();
+            ac_full_show_brands(infrared); // tried them all: back to the list
+        } else {
+            ac.scan_idx++;
+            ac_scan_step(infrared);
+        }
+    } else if(event.event == AC_EVT_SCAN_FOUND) {
+        if(!ac.scanning) return true;
+        ac.brand = ac.scan_idx;
+        ac_scan_stop();
+        ac_brand_io(true);
+        ac_full_show_list(infrared);
+    } else if(event.event == AC_EVT_OPEN_BRANDS) {
+        if(irac_brand_count()) ac_full_show_brands(infrared);
+    } else if(event.event >= AC_EVT_BRAND_BASE) {
+        ac.brand = (uint16_t)(event.event - AC_EVT_BRAND_BASE);
+        ac_brand_io(true);
+        ac_full_show_list(infrared);
+    } else {
+        return false;
+    }
+    return true;
+}
+
+void infrared_scene_universal_ac_full_on_exit(void* context) {
+    InfraredApp* infrared = context;
+    variable_item_list_reset(infrared->var_item_list);
+    submenu_reset(infrared->submenu);
+    dialog_ex_reset(infrared->dialog_ex);
+    ac_scan_stop();
+    ac.picking = false;
+}
