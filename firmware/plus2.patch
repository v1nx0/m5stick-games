diff --git a/applications_user/ir_tools/ir_tools.c b/applications_user/ir_tools/ir_tools.c
new file mode 100644
index 0000000..45fc19a
--- /dev/null
+++ b/applications_user/ir_tools/ir_tools.c
@@ -0,0 +1,403 @@
+// IR Tools (M5StickC Plus2): Sleep Timer, Clap Off, Tilt Remote.
+// Built into the firmware: FAPs cannot reach the IR, mic or IMU APIs on this port.
+#include <furi.h>
+#include <gui/gui.h>
+#include <input/input.h>
+#include <dialogs/dialogs.h>
+#include <storage/storage.h>
+#include <flipper_format/flipper_format.h>
+#include <lib/infrared/signal/infrared_brute_force.h>
+#include <lib/infrared/signal/infrared_signal.h>
+#include <driver/i2s_pdm.h>
+#include <math.h>
+#include "../imu/imu_hal.h"
+
+typedef enum { SMain, STarget, STimerSet, STimerRun, SClap, STilt, SMsg } Screen;
+typedef enum { ModeTimer, ModeClap } Mode;
+
+static const char* const MAIN_ITEMS[] = {"Sleep Timer", "Clap Off", "Tilt Remote"};
+static const struct {
+    const char* name;
+    const char* db;
+    const char* button;
+} TARGETS[] = {
+    {"TV", EXT_PATH("infrared/assets/tv.ir"), "Power"},
+    {"AC", EXT_PATH("infrared/assets/ac.ir"), "Off"},
+    {"Projector", EXT_PATH("infrared/assets/projectors.ir"), "Power"},
+    {"Fan", EXT_PATH("infrared/assets/fans.ir"), "Power"},
+    {"Audio", EXT_PATH("infrared/assets/audio.ir"), "Power"},
+};
+#define TARGET_COUNT COUNT_OF(TARGETS)
+// tilt: accel axis -> saved-remote button names (first one found in the file wins)
+static const char* const TILT_BUTTONS[4][3] = {
+    {"Vol_up", "VOL+", "Volume_up"},
+    {"Vol_dn", "VOL-", "Volume_down"},
+    {"Ch_next", "CH+", "Channel_up"},
+    {"Ch_prev", "CH-", "Channel_down"},
+};
+
+typedef struct {
+    FuriMutex* mutex;
+    Screen screen;
+    Mode mode;
+    int sel, target, minutes;
+    uint32_t end_ms;
+    char msg[48];
+    // clap
+    i2s_chan_handle_t mic;
+    int level, claps;
+    uint32_t last_clap, cooldown_until;
+    float baseline;
+    // tilt
+    InfraredSignal* tilt_sig[4];
+    int tilt_dir;
+    uint32_t tilt_next;
+    float ax, ay;
+} App;
+
+static uint32_t now_ms(void) {
+    return (uint32_t)((uint64_t)furi_get_tick() * 1000u / furi_kernel_get_tick_frequency());
+}
+
+static void draw_list(Canvas* c, const char* title, const char* const* items, int n, int sel) {
+    canvas_set_font(c, FontPrimary);
+    canvas_draw_str(c, 2, 10, title);
+    canvas_set_font(c, FontSecondary);
+    int first = sel > 3 ? sel - 3 : 0;
+    for(int i = first; i < n && i < first + 4; i++) {
+        int y = 24 + (i - first) * 11;
+        if(i == sel) {
+            canvas_draw_rbox(c, 0, y - 9, 128, 11, 2);
+            canvas_set_color(c, ColorWhite);
+        }
+        canvas_draw_str(c, 4, y, items[i]);
+        canvas_set_color(c, ColorBlack);
+    }
+}
+
+static void draw_cb(Canvas* c, void* ctx) {
+    App* a = ctx;
+    furi_mutex_acquire(a->mutex, FuriWaitForever);
+    canvas_clear(c);
+    char b[48];
+    switch(a->screen) {
+    case SMain:
+        draw_list(c, "IR Tools", MAIN_ITEMS, 3, a->sel);
+        break;
+    case STarget: {
+        const char* names[TARGET_COUNT];
+        for(size_t i = 0; i < TARGET_COUNT; i++) names[i] = TARGETS[i].name;
+        draw_list(c, a->mode == ModeTimer ? "Timer: turn off" : "Clap: turn off", names, TARGET_COUNT, a->sel);
+        break;
+    }
+    case STimerSet:
+        canvas_set_font(c, FontPrimary);
+        snprintf(b, sizeof(b), "%s off in", TARGETS[a->target].name);
+        canvas_draw_str_aligned(c, 64, 12, AlignCenter, AlignCenter, b);
+        canvas_set_font(c, FontBigNumbers);
+        snprintf(b, sizeof(b), "%d", a->minutes);
+        canvas_draw_str_aligned(c, 64, 34, AlignCenter, AlignCenter, b);
+        canvas_set_font(c, FontSecondary);
+        canvas_draw_str_aligned(c, 64, 56, AlignCenter, AlignCenter, "min  Up/Down  OK=start");
+        break;
+    case STimerRun: {
+        uint32_t left = a->end_ms > now_ms() ? (a->end_ms - now_ms()) / 1000 : 0;
+        canvas_set_font(c, FontPrimary);
+        snprintf(b, sizeof(b), "%s off in", TARGETS[a->target].name);
+        canvas_draw_str_aligned(c, 64, 12, AlignCenter, AlignCenter, b);
+        canvas_set_font(c, FontBigNumbers);
+        snprintf(b, sizeof(b), "%lu:%02lu", (unsigned long)(left / 60), (unsigned long)(left % 60));
+        canvas_draw_str_aligned(c, 64, 34, AlignCenter, AlignCenter, b);
+        canvas_set_font(c, FontSecondary);
+        canvas_draw_str_aligned(c, 64, 56, AlignCenter, AlignCenter, "Back = cancel");
+        break;
+    }
+    case SClap:
+        canvas_set_font(c, FontPrimary);
+        snprintf(b, sizeof(b), "Clap twice: %s off", TARGETS[a->target].name);
+        canvas_draw_str_aligned(c, 64, 10, AlignCenter, AlignCenter, b);
+        canvas_draw_frame(c, 4, 24, 120, 10);
+        canvas_draw_box(c, 4, 24, a->level * 120 / 100, 10);
+        canvas_set_font(c, FontSecondary);
+        canvas_draw_str_aligned(c, 64, 46, AlignCenter, AlignCenter, a->mic ? "Listening..." : "Mic not available");
+        canvas_draw_str_aligned(c, 64, 58, AlignCenter, AlignCenter, "Back = stop");
+        break;
+    case STilt:
+        canvas_set_font(c, FontPrimary);
+        canvas_draw_str_aligned(c, 64, 10, AlignCenter, AlignCenter, "Tilt Remote");
+        canvas_set_font(c, FontSecondary);
+        canvas_draw_str_aligned(c, 64, 24, AlignCenter, AlignCenter, "Tilt L/R: volume");
+        canvas_draw_str_aligned(c, 64, 34, AlignCenter, AlignCenter, "Tilt fwd/back: channel");
+        canvas_draw_circle(c, 64, 50, 7);
+        canvas_draw_disc(c, 64 + (int)(a->ax * 7), 50 + (int)(a->ay * 7), 2);
+        break;
+    case SMsg:
+        canvas_set_font(c, FontPrimary);
+        canvas_draw_str_aligned(c, 64, 28, AlignCenter, AlignCenter, a->msg);
+        canvas_set_font(c, FontSecondary);
+        canvas_draw_str_aligned(c, 64, 50, AlignCenter, AlignCenter, "OK / Back");
+        break;
+    }
+    furi_mutex_release(a->mutex);
+}
+
+static void input_cb(InputEvent* e, void* ctx) {
+    furi_message_queue_put(ctx, e, 0);
+}
+
+static void set_msg(App* a, const char* m) {
+    strlcpy(a->msg, m, sizeof(a->msg));
+    a->screen = SMsg;
+}
+
+// Sends the target's power/off button for every brand in the universal DB.
+// Returns false if Back was pressed. Runs in the app thread (blocking by design).
+static bool send_universal(App* a, ViewPort* vp, FuriMessageQueue* q) {
+    InfraredBruteForce* bf = infrared_brute_force_alloc();
+    infrared_brute_force_set_db_filename(bf, TARGETS[a->target].db);
+    infrared_brute_force_add_record(bf, 0, TARGETS[a->target].button);
+    uint32_t count = 0;
+    bool done = true;
+    if(infrared_brute_force_calculate_messages(bf) != InfraredErrorCodeNone ||
+       !infrared_brute_force_start(bf, 0, &count)) {
+        furi_mutex_acquire(a->mutex, FuriWaitForever);
+        set_msg(a, "No IR codes on stick");
+        furi_mutex_release(a->mutex);
+        infrared_brute_force_free(bf);
+        return true;
+    }
+    for(uint32_t i = 0; i < count; i++) {
+        InputEvent e;
+        if(furi_message_queue_get(q, &e, 0) == FuriStatusOk && e.key == InputKeyBack &&
+           e.type == InputTypeShort) {
+            done = false;
+            break;
+        }
+        furi_mutex_acquire(a->mutex, FuriWaitForever);
+        snprintf(a->msg, sizeof(a->msg), "Sending %lu/%lu", (unsigned long)i + 1, (unsigned long)count);
+        a->screen = SMsg;
+        furi_mutex_release(a->mutex);
+        view_port_update(vp);
+        infrared_brute_force_send(bf, i);
+    }
+    infrared_brute_force_stop(bf);
+    infrared_brute_force_free(bf);
+    furi_mutex_acquire(a->mutex, FuriWaitForever);
+    set_msg(a, done ? "Sent!" : "Stopped");
+    furi_mutex_release(a->mutex);
+    return done;
+}
+
+static void mic_start(App* a) {
+    i2s_chan_config_t cc = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
+    if(i2s_new_channel(&cc, NULL, &a->mic) != ESP_OK) {
+        a->mic = NULL;
+        return;
+    }
+    // M5StickC Plus2 SPM1423 PDM mic: CLK G0, DATA G34 (G0 is shared with a CC1101 SCK)
+    i2s_pdm_rx_config_t pc = {
+        .clk_cfg = I2S_PDM_RX_CLK_DEFAULT_CONFIG(16000),
+        .slot_cfg = I2S_PDM_RX_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_MONO),
+        .gpio_cfg = {.clk = GPIO_NUM_0, .din = GPIO_NUM_34},
+    };
+    if(i2s_channel_init_pdm_rx_mode(a->mic, &pc) != ESP_OK || i2s_channel_enable(a->mic) != ESP_OK) {
+        i2s_del_channel(a->mic);
+        a->mic = NULL;
+    }
+    a->baseline = 500;
+    a->claps = 0;
+}
+
+static void mic_stop(App* a) {
+    if(!a->mic) return;
+    i2s_channel_disable(a->mic);
+    i2s_del_channel(a->mic);
+    a->mic = NULL;
+}
+
+// One mic chunk (~32 ms). Returns true on a double clap.
+static bool mic_poll(App* a) {
+    int16_t buf[512];
+    size_t got = 0;
+    if(!a->mic || i2s_channel_read(a->mic, buf, sizeof(buf), &got, 50) != ESP_OK) return false;
+    int peak = 0;
+    for(size_t i = 0; i < got / 2; i++) peak = MAX(peak, abs(buf[i]));
+    a->level = MIN(100, peak * 100 / 20000);
+    uint32_t t = now_ms();
+    bool loud = peak > 6000 && peak > a->baseline * 6;
+    if(!loud) a->baseline = a->baseline * 0.95f + peak * 0.05f; // tracks room noise
+    if(!loud || t < a->cooldown_until || t - a->last_clap < 120) return false;
+    a->claps = (a->claps && t - a->last_clap < 800) ? a->claps + 1 : 1;
+    a->last_clap = t;
+    if(a->claps < 2) return false;
+    a->claps = 0;
+    a->cooldown_until = t + 3000;
+    return true;
+}
+
+static bool tilt_load(App* a) {
+    DialogsApp* dialogs = furi_record_open(RECORD_DIALOGS);
+    FuriString* path = furi_string_alloc_set(EXT_PATH("infrared"));
+    DialogsFileBrowserOptions opt;
+    dialog_file_browser_set_basic_options(&opt, ".ir", NULL);
+    opt.base_path = EXT_PATH("infrared");
+    bool picked = dialog_file_browser_show(dialogs, path, path, &opt);
+    furi_record_close(RECORD_DIALOGS);
+    int found = 0;
+    if(picked) {
+        Storage* storage = furi_record_open(RECORD_STORAGE);
+        FlipperFormat* ff = flipper_format_buffered_file_alloc(storage);
+        for(int d = 0; d < 4; d++) {
+            for(int n = 0; n < 3 && !a->tilt_sig[d]; n++) {
+                if(!flipper_format_buffered_file_open_existing(ff, furi_string_get_cstr(path))) break;
+                InfraredSignal* s = infrared_signal_alloc();
+                if(infrared_signal_search_by_name_and_read(s, ff, TILT_BUTTONS[d][n]) ==
+                   InfraredErrorCodeNone)
+                    a->tilt_sig[d] = s, found++;
+                else
+                    infrared_signal_free(s);
+                flipper_format_buffered_file_close(ff);
+            }
+        }
+        flipper_format_free(ff);
+        furi_record_close(RECORD_STORAGE);
+    }
+    furi_string_free(path);
+    if(picked && !found) set_msg(a, "No Vol/Ch buttons");
+    return picked && found;
+}
+
+static void tilt_free(App* a) {
+    for(int d = 0; d < 4; d++)
+        if(a->tilt_sig[d]) infrared_signal_free(a->tilt_sig[d]), a->tilt_sig[d] = NULL;
+}
+
+// 0 vol up, 1 vol down, 2 ch next, 3 ch prev, -1 level
+static int tilt_dir(float ax, float ay) {
+    if(fabsf(ax) > 0.55f && fabsf(ax) >= fabsf(ay)) return ax > 0 ? 0 : 1;
+    if(fabsf(ay) > 0.55f) return ay < 0 ? 2 : 3;
+    return -1;
+}
+
+int32_t ir_tools_app(void* p) {
+    UNUSED(p);
+    App* a = malloc(sizeof(App));
+    memset(a, 0, sizeof(App));
+    a->mutex = furi_mutex_alloc(FuriMutexTypeNormal);
+    a->minutes = 30;
+    FuriMessageQueue* q = furi_message_queue_alloc(16, sizeof(InputEvent));
+    ViewPort* vp = view_port_alloc();
+    view_port_draw_callback_set(vp, draw_cb, a);
+    view_port_input_callback_set(vp, input_cb, q);
+    Gui* gui = furi_record_open(RECORD_GUI);
+    gui_add_view_port(gui, vp, GuiLayerFullscreen);
+
+    for(bool run = true; run;) {
+        InputEvent e;
+        // wake only when there is work: mic polling, tilt sampling, countdown redraw
+        uint32_t wait = (a->screen == SClap && a->mic) ? 0 :
+                        a->screen == STilt             ? 50 :
+                        a->screen == STimerRun         ? 500 :
+                                                         FuriWaitForever;
+        bool got = furi_message_queue_get(q, &e, wait) == FuriStatusOk;
+        bool step = got && (e.type == InputTypePress || e.type == InputTypeRepeat);
+        bool ok = got && e.key == InputKeyOk && e.type == InputTypeShort;
+        bool back = got && e.key == InputKeyBack && e.type == InputTypeShort;
+        int d = !step ? 0 : (e.key == InputKeyUp || e.key == InputKeyLeft) ? -1 :
+                (e.key == InputKeyDown || e.key == InputKeyRight)            ? 1 :
+                                                                               0;
+        bool fire = false;
+        furi_mutex_acquire(a->mutex, FuriWaitForever);
+        switch(a->screen) {
+        case SMain:
+            a->sel = (a->sel + d + 3) % 3;
+            if(back) run = false;
+            if(ok && a->sel == 2) {
+                furi_mutex_release(a->mutex);
+                bool loaded = tilt_load(a);
+                furi_mutex_acquire(a->mutex, FuriWaitForever);
+                if(loaded) {
+                    imu_init();
+                    a->screen = STilt;
+                    a->tilt_dir = -1;
+                }
+            } else if(ok) {
+                a->mode = a->sel == 0 ? ModeTimer : ModeClap;
+                a->screen = STarget;
+                a->sel = 0;
+            }
+            break;
+        case STarget:
+            a->sel = (a->sel + d + (int)TARGET_COUNT) % (int)TARGET_COUNT;
+            if(back) a->screen = SMain, a->sel = 0;
+            if(ok) {
+                a->target = a->sel;
+                if(a->mode == ModeTimer) {
+                    a->screen = STimerSet;
+                } else {
+                    mic_start(a);
+                    a->screen = SClap;
+                }
+            }
+            break;
+        case STimerSet:
+            a->minutes = CLAMP(a->minutes - d * (a->minutes >= 60 ? 5 : 1), 180, 1); // Up = more
+            if(back) a->screen = STarget;
+            if(ok) a->end_ms = now_ms() + (uint32_t)a->minutes * 60000u, a->screen = STimerRun;
+            break;
+        case STimerRun:
+            if(back) a->screen = STimerSet;
+            else if(now_ms() >= a->end_ms) fire = true;
+            break;
+        case SClap:
+            if(back) mic_stop(a), a->screen = STarget;
+            break;
+        case STilt:
+            if(back) imu_deinit(), tilt_free(a), a->screen = SMain;
+            break;
+        case SMsg:
+            if(ok || back) a->screen = SMain, a->sel = 0;
+            break;
+        }
+        Screen scr = a->screen;
+        furi_mutex_release(a->mutex);
+
+        if(fire) {
+            send_universal(a, vp, q);
+        } else if(scr == SClap && mic_poll(a)) {
+            mic_stop(a); // free G0/I2S while the IR LED blasts, then listen again
+            send_universal(a, vp, q);
+            furi_mutex_acquire(a->mutex, FuriWaitForever);
+            if(a->screen == SMsg) a->screen = SClap;
+            furi_mutex_release(a->mutex);
+            mic_start(a);
+        } else if(scr == STilt) {
+            ImuData imu;
+            if(imu_read(&imu)) {
+                int dir = tilt_dir(imu.accel_x, imu.accel_y);
+                furi_mutex_acquire(a->mutex, FuriWaitForever);
+                a->ax = CLAMP(imu.accel_x, 1.0f, -1.0f);
+                a->ay = CLAMP(imu.accel_y, 1.0f, -1.0f);
+                bool send = dir >= 0 && a->tilt_sig[dir] &&
+                            (dir != a->tilt_dir || now_ms() >= a->tilt_next);
+                if(send) a->tilt_next = now_ms() + 450; // held tilt repeats ~2x/s
+                a->tilt_dir = dir;
+                furi_mutex_release(a->mutex);
+                if(send) infrared_signal_transmit(a->tilt_sig[dir]);
+            }
+        }
+        view_port_update(vp);
+    }
+
+    mic_stop(a);
+    imu_deinit(); // no-op unless Tilt was open
+    tilt_free(a);
+    view_port_enabled_set(vp, false);
+    gui_remove_view_port(gui, vp);
+    furi_record_close(RECORD_GUI);
+    view_port_free(vp);
+    furi_message_queue_free(q);
+    furi_mutex_free(a->mutex);
+    free(a);
+    return 0;
+}
