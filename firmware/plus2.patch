diff --git a/applications_user/games_menu/games_menu.c b/applications_user/games_menu/games_menu.c
new file mode 100644
index 0000000..06cc3b6
--- /dev/null
+++ b/applications_user/games_menu/games_menu.c
@@ -0,0 +1,107 @@
+// Games: lists the built-in game pack (no SD card on M5StickC Plus2, so the
+// games are compiled into the firmware) and runs the picked one in this thread.
+// Calling the entry directly: a loader start from inside a running app is
+// rejected ("Loader is locked") because this app still owns the loader.
+#include <furi.h>
+#include <gui/gui.h>
+#include <gui/view_dispatcher.h>
+#include <gui/modules/submenu.h>
+#include <furi_hal_display.h>
+
+extern int32_t snake_game_app(void* p);
+extern int32_t sky_hopper_app(void* p);
+extern int32_t sky_hopper_color_app(void* p);
+extern int32_t rps_color_app(void* p);
+extern int32_t brick_breaker_app(void* p);
+extern int32_t mines_app(void* p);
+extern int32_t tic_tac_toe_app(void* p);
+extern int32_t four_in_a_row_app(void* p);
+extern int32_t merge_tiles_app(void* p);
+extern int32_t pattern_memory_app(void* p);
+extern int32_t reaction_test_app(void* p);
+extern int32_t space_dodge_app(void* p);
+extern int32_t star_shooter_app(void* p);
+extern int32_t hi_lo_app(void* p);
+
+// RGB888 -> RGB565, byte-swapped for the ST7789 (the display driver's color format)
+#define RGB(r, g, b)                                                                         ((uint16_t)(((((r) & 0xF8) << 8 | ((g) & 0xFC) << 3 | (b) >> 3) >> 8) |                              (((((r) & 0xF8) << 8 | ((g) & 0xFC) << 3 | (b) >> 3) & 0xFF) << 8)))
+
+// Each game gets its own two colors while it runs: field = background fill,
+// ink = everything the game draws. The UI colors come back when it exits.
+static const struct {
+    const char* name;
+    int32_t (*entry)(void*);
+    uint16_t field, ink;
+} GAMES[] = {
+    {"Snake", snake_game_app, RGB(0, 24, 0), RGB(80, 255, 80)},
+    {"Sky Hopper Color", sky_hopper_color_app, 0, 0}, // full color, draws its own
+    {"Rock Paper Scissors", rps_color_app, 0, 0},
+    {"Sky Hopper", sky_hopper_app, RGB(10, 30, 70), RGB(130, 210, 255)},
+    {"Brick Breaker", brick_breaker_app, RGB(24, 0, 36), RGB(255, 150, 0)},
+    {"Mines", mines_app, RGB(30, 30, 30), RGB(255, 80, 80)},
+    {"Tic-Tac-Toe", tic_tac_toe_app, RGB(0, 0, 48), RGB(255, 255, 255)},
+    {"Four in a Row", four_in_a_row_app, RGB(0, 20, 80), RGB(255, 220, 0)},
+    {"Merge Tiles", merge_tiles_app, RGB(48, 26, 0), RGB(255, 205, 130)},
+    {"Pattern Memory", pattern_memory_app, RGB(36, 0, 36), RGB(255, 110, 255)},
+    {"Reaction Test", reaction_test_app, RGB(0, 0, 0), RGB(0, 255, 255)},
+    {"Space Dodge", space_dodge_app, RGB(0, 0, 24), RGB(210, 210, 255)},
+    {"Star Shooter", star_shooter_app, RGB(0, 0, 0), RGB(255, 255, 0)},
+    {"Hi-Lo", hi_lo_app, RGB(0, 50, 0), RGB(255, 255, 255)},
+};
+
+typedef struct {
+    ViewDispatcher* vd;
+    int picked;
+} GamesMenu;
+
+static void pick_cb(void* ctx, uint32_t index) {
+    GamesMenu* m = ctx;
+    m->picked = (int)index;
+    view_dispatcher_stop(m->vd);
+}
+
+static bool back_cb(void* ctx) {
+    GamesMenu* m = ctx;
+    view_dispatcher_stop(m->vd);
+    return true;
+}
+
+int32_t games_menu_app(void* p) {
+    UNUSED(p);
+    Gui* gui = furi_record_open(RECORD_GUI);
+    uint32_t last = 0;
+    for(;;) {
+        GamesMenu m = {.picked = -1};
+        m.vd = view_dispatcher_alloc();
+        Submenu* sm = submenu_alloc();
+        submenu_set_header(sm, "Games");
+        for(size_t i = 0; i < COUNT_OF(GAMES); i++)
+            submenu_add_item(sm, GAMES[i].name, i, pick_cb, &m);
+        submenu_set_selected_item(sm, last); // back on the game you just played
+        view_dispatcher_set_event_callback_context(m.vd, &m);
+        view_dispatcher_set_navigation_event_callback(m.vd, back_cb);
+        view_dispatcher_add_view(m.vd, 0, submenu_get_view(sm));
+        view_dispatcher_attach_to_gui(m.vd, gui, ViewDispatcherTypeFullscreen);
+        view_dispatcher_switch_to_view(m.vd, 0);
+        view_dispatcher_run(m.vd);
+
+        // tear the menu down before the game takes the screen
+        view_dispatcher_remove_view(m.vd, 0);
+        submenu_free(sm);
+        view_dispatcher_free(m.vd);
+
+        if(m.picked < 0) break;
+        last = (uint32_t)m.picked;
+        const uint16_t ui_field = furi_hal_display_get_fg_color();
+        const uint16_t ui_ink = furi_hal_display_get_bg_color();
+        if(GAMES[m.picked].field || GAMES[m.picked].ink) { // 0,0 = full-color game
+            furi_hal_display_set_fg_color(GAMES[m.picked].field);
+            furi_hal_display_set_bg_color(GAMES[m.picked].ink);
+        }
+        GAMES[m.picked].entry(NULL);
+        furi_hal_display_set_fg_color(ui_field);
+        furi_hal_display_set_bg_color(ui_ink);
+    }
+    furi_record_close(RECORD_GUI);
+    return 0;
+}
