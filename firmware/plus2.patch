diff --git a/applications/main/wlan_app/scenes/scene_wol.c b/applications/main/wlan_app/scenes/scene_wol.c
new file mode 100644
index 0000000..e1cb06d
--- /dev/null
+++ b/applications/main/wlan_app/scenes/scene_wol.c
@@ -0,0 +1,129 @@
+#include "../wlan_app.h"
+#include <storage/storage.h>
+#include <lwip/sockets.h>
+
+// Wake-on-LAN: type the PC's MAC once (saved), send the magic packet as a UDP
+// broadcast on ports 9 and 7. Needs a WiFi connection on the PC's network.
+#define WOL_FILE EXT_PATH("apps_data/wol_mac.txt")
+#define WOL_EVT_ENTERED 0x5100u
+#define WOL_EVT_DONE 0x5101u
+
+static char wol_buf[24];
+
+static void wol_entered_cb(void* ctx) {
+    WlanApp* app = ctx;
+    view_dispatcher_send_custom_event(app->view_dispatcher, WOL_EVT_ENTERED);
+}
+
+static void wol_popup_cb(void* ctx) {
+    WlanApp* app = ctx;
+    view_dispatcher_send_custom_event(app->view_dispatcher, WOL_EVT_DONE);
+}
+
+// Accepts AA:BB:CC:DD:EE:FF, AA-BB-..., or 12 bare hex digits.
+static bool wol_parse(const char* s, uint8_t mac[6]) {
+    int n = 0, half = -1;
+    for(; *s && n < 6; s++) {
+        int v = (*s >= '0' && *s <= '9') ? *s - '0' :
+                (*s >= 'a' && *s <= 'f') ? *s - 'a' + 10 :
+                (*s >= 'A' && *s <= 'F') ? *s - 'A' + 10 :
+                                           -1;
+        if(v < 0) {
+            if(*s != ':' && *s != '-' && *s != ' ') return false;
+            continue;
+        }
+        if(half < 0) {
+            half = v;
+        } else {
+            mac[n++] = (uint8_t)(half << 4 | v);
+            half = -1;
+        }
+    }
+    return n == 6 && half < 0 && !*s;
+}
+
+static bool wol_send(const uint8_t mac[6]) {
+    uint8_t pkt[102];
+    memset(pkt, 0xFF, 6);
+    for(int i = 1; i <= 16; i++) memcpy(pkt + i * 6, mac, 6);
+    int sock = lwip_socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if(sock < 0) return false;
+    int yes = 1;
+    lwip_setsockopt(sock, SOL_SOCKET, SO_BROADCAST, &yes, sizeof(yes));
+    bool ok = false;
+    const uint16_t ports[] = {9, 7};
+    for(int i = 0; i < 2; i++) {
+        struct sockaddr_in to = {.sin_family = AF_INET, .sin_port = htons(ports[i])};
+        to.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+        for(int r = 0; r < 3; r++) // UDP is lossy over WiFi; NICs ignore duplicates
+            ok |= lwip_sendto(sock, pkt, sizeof(pkt), 0, (struct sockaddr*)&to, sizeof(to)) ==
+                  (int)sizeof(pkt);
+    }
+    lwip_close(sock);
+    return ok;
+}
+
+static void wol_file(bool save) {
+    Storage* storage = furi_record_open(RECORD_STORAGE);
+    File* f = storage_file_alloc(storage);
+    if(save) {
+        storage_common_mkdir(storage, EXT_PATH("apps_data"));
+        if(storage_file_open(f, WOL_FILE, FSAM_WRITE, FSOM_CREATE_ALWAYS))
+            storage_file_write(f, wol_buf, strlen(wol_buf));
+    } else if(storage_file_open(f, WOL_FILE, FSAM_READ, FSOM_OPEN_EXISTING)) {
+        size_t r = storage_file_read(f, wol_buf, sizeof(wol_buf) - 1);
+        wol_buf[r] = '\0';
+    }
+    storage_file_close(f);
+    storage_file_free(f);
+    furi_record_close(RECORD_STORAGE);
+}
+
+static void wol_popup(WlanApp* app, const char* text) {
+    popup_reset(app->popup);
+    popup_set_header(app->popup, "Wake-on-LAN", 64, 10, AlignCenter, AlignTop);
+    popup_set_text(app->popup, text, 64, 36, AlignCenter, AlignCenter);
+    popup_set_context(app->popup, app);
+    popup_set_callback(app->popup, wol_popup_cb);
+    popup_set_timeout(app->popup, 1800);
+    popup_enable_timeout(app->popup);
+    view_dispatcher_switch_to_view(app->view_dispatcher, WlanAppViewPopup);
+}
+
+void wlan_app_scene_wol_on_enter(void* context) {
+    WlanApp* app = context;
+    app->wol_flow = false;
+    wol_buf[0] = '\0';
+    wol_file(false);
+    text_input_reset(app->text_input);
+    text_input_set_header_text(app->text_input, "PC MAC (AA:BB:CC:DD:EE:FF)");
+    text_input_set_result_callback(
+        app->text_input, wol_entered_cb, app, wol_buf, sizeof(wol_buf), false);
+    view_dispatcher_switch_to_view(app->view_dispatcher, WlanAppViewTextInput);
+}
+
+bool wlan_app_scene_wol_on_event(void* context, SceneManagerEvent event) {
+    WlanApp* app = context;
+    if(event.type != SceneManagerEventTypeCustom) return false;
+    if(event.event == WOL_EVT_ENTERED) {
+        uint8_t mac[6];
+        if(!wol_parse(wol_buf, mac)) {
+            wol_popup(app, "Bad MAC address");
+        } else {
+            wol_file(true);
+            wol_popup(app, wol_send(mac) ? "Magic packet sent!" : "Send failed");
+        }
+        return true;
+    }
+    if(event.event == WOL_EVT_DONE) {
+        scene_manager_search_and_switch_to_previous_scene(app->scene_manager, WlanAppSceneMain);
+        return true;
+    }
+    return false;
+}
+
+void wlan_app_scene_wol_on_exit(void* context) {
+    WlanApp* app = context;
+    text_input_reset(app->text_input);
+    popup_reset(app->popup);
+}
