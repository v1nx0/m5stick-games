diff --git a/components/irac/shim/IRsend_test.h b/components/irac/shim/IRsend_test.h
new file mode 100644
index 0000000..b0885d2
--- /dev/null
+++ b/components/irac/shim/IRsend_test.h
@@ -0,0 +1,52 @@
+// Replaces IRremoteESP8266's test sender: under UNIT_TEST every AC class holds an
+// IRsendTest member, so overriding mark()/space() here captures the exact timings the
+// library would send. The buffer is global (AC objects live on the stack).
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include "IRrecv.h"
+#include "IRsend.h"
+#include "IRtimer.h"
+
+extern uint32_t* irac_cap_buf;
+extern size_t irac_cap_size, irac_cap_n;
+extern uint32_t irac_cap_freq;
+extern bool irac_cap_overflow;
+
+class IRsendTest : public IRsend {
+public:
+    explicit IRsendTest(uint16_t pin, bool inverted = false, bool use_modulation = true)
+        : IRsend(pin, inverted, use_modulation) {
+    }
+    uint16_t mark(uint16_t usec) override {
+        push(true, usec);
+        return 0;
+    }
+    void space(uint32_t usec) override {
+        push(false, usec);
+    }
+
+    // IRac.cpp's unit-test hook touches these; it only runs with a test receiver
+    // attached (_utReceiver), never here. Static so AC objects stay small on the stack.
+    static decode_results capture;
+    void makeDecodeResult(uint16_t offset = 0) {
+        (void)offset;
+    }
+
+private:
+    // even index = mark, odd = space; same-kind neighbours merge; leading spaces dropped
+    void push(bool is_mark, uint32_t usec) {
+        IRtimer::add(usec);
+        if(!usec) return;
+        if(irac_cap_n == 0 && !is_mark) return;
+        irac_cap_freq = _freq_unittest;
+        bool last_is_mark = irac_cap_n && ((irac_cap_n - 1) % 2 == 0);
+        if(irac_cap_n && last_is_mark == is_mark) {
+            irac_cap_buf[irac_cap_n - 1] += usec;
+        } else if(irac_cap_n < irac_cap_size) {
+            irac_cap_buf[irac_cap_n++] = usec;
+        } else {
+            irac_cap_overflow = true;
+        }
+    }
+};
