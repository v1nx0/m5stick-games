diff --git a/components/irac/irac_glue.cpp b/components/irac/irac_glue.cpp
new file mode 100644
index 0000000..7b82423
--- /dev/null
+++ b/components/irac/irac_glue.cpp
@@ -0,0 +1,83 @@
+// C API over IRremoteESP8266's IRac: one common AC state (power/mode/temp/fan) mapped
+// onto every AC protocol by the library itself, captured via shim/IRsend_test.h.
+#include "irac.h"
+#include "IRac.h"
+#include "IRsend_test.h"
+
+uint32_t* irac_cap_buf = nullptr;
+size_t irac_cap_size = 0, irac_cap_n = 0;
+uint32_t irac_cap_freq = 38000;
+bool irac_cap_overflow = false;
+decode_results IRsendTest::capture;
+
+namespace {
+struct AcBrand {
+    const char* name;
+    decode_type_t type;
+};
+// generated by tools/gen_ac_table.py from the pinned library: brand -> protocol
+const AcBrand AC_BRANDS[] = {
+#include "ac_brands.inc"
+};
+} // namespace
+
+extern "C" size_t irac_brand_count(void) {
+    return sizeof(AC_BRANDS) / sizeof(AC_BRANDS[0]);
+}
+
+extern "C" const char* irac_brand_name(size_t index) {
+    return index < irac_brand_count() ? AC_BRANDS[index].name : "";
+}
+
+extern "C" bool irac_build(
+    size_t brand,
+    bool power,
+    IracMode mode,
+    uint8_t temp_c,
+    IracFan fan,
+    uint32_t* timings,
+    size_t capacity,
+    size_t* count,
+    uint32_t* frequency) {
+    *count = 0;
+    *frequency = 0;
+    if(brand >= irac_brand_count() || !timings || capacity < 3) return false;
+
+    static const stdAc::opmode_t MODES[] = {
+        stdAc::opmode_t::kCool,
+        stdAc::opmode_t::kHeat,
+        stdAc::opmode_t::kDry,
+        stdAc::opmode_t::kAuto,
+        stdAc::opmode_t::kFan};
+    static const stdAc::fanspeed_t FANS[] = {
+        stdAc::fanspeed_t::kAuto,
+        stdAc::fanspeed_t::kLow,
+        stdAc::fanspeed_t::kMedium,
+        stdAc::fanspeed_t::kHigh};
+
+    stdAc::state_t st;
+    IRac::initState(&st);
+    st.protocol = AC_BRANDS[brand].type;
+    st.model = -1; // library default model for the protocol
+    st.power = power;
+    st.mode = MODES[mode <= IracModeFan ? mode : IracModeCool];
+    st.celsius = true;
+    st.degrees = temp_c;
+    st.fanspeed = FANS[fan <= IracFanHigh ? fan : IracFanAuto];
+
+    irac_cap_buf = timings;
+    irac_cap_size = capacity;
+    irac_cap_n = 0;
+    irac_cap_freq = 38000;
+    irac_cap_overflow = false;
+
+    IRac ac(0); // pin unused: IRsendTest captures instead of driving a GPIO
+    bool ok = ac.sendAc(st, nullptr);
+
+    if(irac_cap_n % 2 == 0 && irac_cap_n) irac_cap_n--; // raw signals must end on a mark
+    irac_cap_buf = nullptr;
+    if(!ok || irac_cap_overflow || irac_cap_n == 0) return false;
+    *count = irac_cap_n;
+    *frequency = irac_cap_freq ? irac_cap_freq : 38000;
+    return true;
+}
