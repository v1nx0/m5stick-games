@@ -195,6 +197,19 @@ void app_main(void) {
 
     ESP_LOGI(TAG, "All services started, entering background...");
 
+#if CONFIG_PM_ENABLE
+    // Battery: let the CPU drop to 80 MHz while idle (drivers lock full speed when
+    // busy). 80 MHz is the floor where the ESP32 APB clock stays 80 MHz, so SPI/RMT/
+    // LEDC/I2C timing is untouched. No auto light sleep: it breaks IR/LCD timing.
+    esp_pm_config_t pm = {
+        .max_freq_mhz = CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ,
+        .min_freq_mhz = 80,
+        .light_sleep_enable = false,
+    };
+    esp_err_t pm_err = esp_pm_configure(&pm);
+    ESP_LOGI(TAG, "Power management: %s", esp_err_to_name(pm_err));
+#endif
+
     // This blocks forever (thread scrubber)
     furi_background();
 }
