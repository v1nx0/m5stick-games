diff --git a/components/irac/CMakeLists.txt b/components/irac/CMakeLists.txt
new file mode 100644
index 0000000..65649f7
--- /dev/null
+++ b/components/irac/CMakeLists.txt
@@ -0,0 +1,19 @@
+# AC full control: IRremoteESP8266 (LGPL-2.1) AC encoders, captured instead of sent.
+# CI clones the library into lib/ at a pinned commit and generates ac_brands.inc +
+# send_flags.cmake (tools/gen_ac_table.py in v1nx0/m5stick-games). Without lib/ a stub
+# keeps the firmware building (AC Full then reports "no AC library").
+set(IRLIB "${CMAKE_CURRENT_LIST_DIR}/lib/src")
+if(EXISTS "${IRLIB}/IRac.cpp")
+    file(GLOB IR_SRCS "${IRLIB}/*.cpp")
+    idf_component_register(
+        SRCS ${IR_SRCS} "irac_glue.cpp"
+        INCLUDE_DIRS "include"
+        PRIV_INCLUDE_DIRS "shim" "${IRLIB}")
+    # UNIT_TEST: no Arduino; mark()/space() become virtual so shim/IRsend_test.h captures
+    # them. Every protocol off except the AC ones IRac::sendAc needs (send_flags.cmake).
+    target_compile_definitions(${COMPONENT_LIB} PRIVATE UNIT_TEST=1 _IR_ENABLE_DEFAULT_=false)
+    include("${CMAKE_CURRENT_LIST_DIR}/send_flags.cmake")
+    target_compile_options(${COMPONENT_LIB} PRIVATE -w -Os)
+else()
+    idf_component_register(SRCS "irac_stub.c" INCLUDE_DIRS "include")
+endif()
